# ===== Ysello Marketplace Environment Configuration =====

# Core
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGIN=
COOKIE_DOMAIN=
# Production values:
# APP_URL=https://ysello.com
# API_URL=https://api.ysello.com
# CORS_ORIGIN=https://ysello.com,https://www.ysello.com

# Frontend canonical URL and optional webmaster verification tokens
VITE_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
VITE_USE_REMOTE_API=false
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_YANDEX_SITE_VERIFICATION=
VITE_BAIDU_SITE_VERIFICATION=

# Security
JWT_SECRET=change-me-to-a-32-char-minimum-secret-key
CSRF_SECRET=change-me-to-a-32-char-minimum-csrf-secret

# Google OAuth (server-side; never expose the client secret to Vite/browser vars)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Production redirect URI: https://api.ysello.com/auth/google/callback

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ysello

# Redis (Upstash or Railway)
REDIS_URL=redis://localhost:6379

# Marketplace wallet destinations
TOPUP_TRC20_ADDRESS=TDffsBmuyrMsNEQXzzLYfzAwz7W6Jmvb1W
TOPUP_ERC20_ADDRESS=0x5fe0bc617b00812396560e00a47b68a4d19933df
TOPUP_BEP20_ADDRESS=0x5fe0bc617b00812396560e00a47b68a4d19933df
TOPUP_BTC_ADDRESS=1CRoGe5BKjSTYBjxjPaS5NRCP8eyZ8cSpA
TOPUP_ETH_ADDRESS=0x5fe0bc617b00812396560e00a47b68a4d19933df
TOPUP_SOL_ADDRESS=
TOPUP_FEE_TRC20_CENTS=100
TOPUP_FEE_BEP20_CENTS=15
TOPUP_FEE_ERC20_CENTS=450
TOPUP_FEE_BTC_CENTS=250
TOPUP_FEE_ETH_CENTS=350

# Commissions
COMMISSION_SALE_PERCENT=10
COMMISSION_WITHDRAW_PERCENT=0
FROZEN_HOLD_HOURS=72
DOWNLOAD_LINK_EXPIRY_DAYS=7

# Stripe
STRIPE_SECRET_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# SMTP (optional; registration and sign-in work without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Ysello <noreply@ysello.com>
ADMIN_NOTIFICATION_EMAIL=

# Upload
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads
MAX_UPLOAD_BYTES=8388608
MAX_PRODUCT_FILE_BYTES=104857600

# Crypto
CRYPTO_PAYMENT_ADDRESS=
CRYPTO_PAYMENT_ASSET=USDT
CRYPTO_PAYMENT_NETWORK=TRC20
CRYPTO_PAYMENT_TIMEOUT_MINUTES=30
CRYPTO_WEBHOOK_SECRET=

# Dark Shopping supplier API (server-side only; never use a VITE_* variable)
DARK_SHOPPING_API_KEY=
DARK_SHOPPING_API_BASE_URL=https://dark.shopping/api/v1
DARK_SHOPPING_TIMEOUT_MS=15000
DARK_SHOPPING_MARGIN_PERCENT=30
DARK_SHOPPING_RUB_PER_USD=91.5
