# Railway Environment Variables 
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway 
REDIS_URL=redis://default:password@redis.railway.internal:6379 
NODE_ENV=production 
PORT=3000 
APP_URL=https://ysello.com
API_URL=https://api.ysello.com
# API_URL is a public HTTPS origin. Do not paste a Railway TCP proxy,
# DATABASE_URL host, or *.railway.internal address here.
CORS_ORIGIN=https://ysello.com,https://www.ysello.com
COOKIE_DOMAIN=
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CSRF_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ysello.com/google-callback.php
UPLOAD_DIR=/app/uploads
PRIVATE_UPLOAD_DIR=/app/private-uploads
MAX_UPLOAD_BYTES=8388608
MAX_PRODUCT_FILE_BYTES=104857600
TOPUP_TRC20_ADDRESS=TDffsBmuyrMsNEQXzzLYfzAwz7W6Jmvb1W
TOPUP_ERC20_ADDRESS=0x5fe0bc617b00812396560e00a47b68a4d19933df
TOPUP_BEP20_ADDRESS=0x5fe0bc617b00812396560e00a47b68a4d19933df
TOPUP_BTC_ADDRESS=1CRoGe5BKjSTYBjxjPaS5NRCP8eyZ8cSpA
TOPUP_ETH_ADDRESS=0x5fe0bc617b00812396560e00a47b68a4d19933df
TOPUP_SOL_ADDRESS=
TOPUP_FEE_TRC20_CENTS=100
TOPUP_FEE_BEP20_CENTS=15
TOPUP_FEE_ERC20_CENTS=450
TOPUP_FEE_BTC_CENTS=250
TOPUP_FEE_ETH_CENTS=350
COMMISSION_SALE_PERCENT=10
COMMISSION_WITHDRAW_PERCENT=0
FROZEN_HOLD_HOURS=72
# SMTP is optional. Leave SMTP_HOST, SMTP_USER, SMTP_PASS, and EMAIL_FROM
# unset when email delivery is not configured; registration and sign-in work.
# Keep GOOGLE_CLIENT_SECRET on Railway only. Never add it to Vercel or a
# VITE_* variable. Rotate any credential that has been shared publicly.
# Attach Railway volumes at /app/uploads and /app/private-uploads so logos,
# product images, and seller delivery files survive deployments.
